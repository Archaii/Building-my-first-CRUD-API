# Copy this file to .env. .env is git-ignored; this file is committed so others
# know which keys to set. The placeholder values work as-is for local development.

# Used by docker compose to create the database and to build the API's connection string.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tasks

# Used only when running the API directly on your machine (uvicorn outside Docker).
# Must match the values above; port 5433 is where compose publishes the database.
DATABASE_URL=postgresql://postgres:change-me@localhost:5433/tasks
